# Attribution policy (D-52), shared by the commit-msg hook and CI.
# Whole-line identity trailers and attribution footers only.
#
# `define NAME = body` lines declare a named fragment; later lines use it as
# {{NAME}}. Every model, vendor and tool name is listed ONCE, below.
#
# AINAME: after a known name ANY trailing qualifier words or versions are
# accepted (`AI`, `Agent`, `Advanced`, `R1`, `2.0 Flash Thinking`,
# `Workspace`, ...), so a new product tier needs no new rule. It applies to
# footers and to trailers without an e-mail address.
# IDNAME: a trailer that carries a non-vendor e-mail address is how a human
# co-author is credited, and people share first names with models (a person
# called Claude). There the name may be followed only by versions and the
# QUALIFIER words below; vendor addresses are matched by the e-mail rules.
define DASH = \-\x{2010}-\x{2015}\x{2043}\x{2212}\x{2796}\x{02D7}\x{FE58}\x{FE63}\x{FF0D}
define VENDOR = (?:google|alphabet|deepmind|openai|anthropic|meta|facebook|microsoft|github|amazon|aws|mistral|xai|x\.ai|deepseek|alibaba|cognition|cursor|codeium|nvidia|ibm|cohere|perplexity|apple|moonshot|zhipu)
define MODEL = (?:claude|chatgpt|gpt|codex|gemini|gemma|bard|copilot|cursor|grok|sonnet|opus|haiku|deepseek|qwen|qwq|llama|mistral|mixtral|codestral|devin|aider|windsurf|codeium|amazon[\s_-]*q|jules|openai|anthropic|antigravity|cline|tabnine|phind|kimi|o[1-9])
define WORD = [\p{L}\p{N}][\p{L}\p{N}.+'\x{2019}]*
define SEP = [\s_{{DASH}}:/,&()]
define AINAME = (?:(?:{{VENDOR}}(?:[\s_-]*ai)?(?:['\x{2019}]s)?[\s_-]+)*{{MODEL}}[\p{L}\p{N}.+]*(?:{{SEP}}+{{WORD}})*{{SEP}}*)
define QUALIFIER = (?:ai|code|sonnet|opus|haiku|flash|pro|mini|nano|turbo|large|small|medium|coder|instruct|sol|developer|codex|lite|preview|cli|assist|assistant|editor|agent|agents|chat|workspace|advanced|experimental|exp|thinking|reasoning|reasoner|high|low|max|ultra|plus|online|bot|app|api|web|desktop|extension|ide|enterprise|business|team)
define VERSION = [vr]?\d[\p{L}\p{N}.+]*
define IDNAME = (?:(?:{{VENDOR}}(?:[\s_-]*ai)?(?:['\x{2019}]s)?[\s_-]+)*{{MODEL}}(?:\d[\p{L}\p{N}.+]*)?(?:{{SEP}}+(?:{{QUALIFIER}}|{{VERSION}})\b)*{{SEP}}*)
define DECOR = (?:>\s*)?(?:[\p{So}\p{Sk}\x{FE0F}\x{200D}]\s*)*

^\s*{{DECOR}}(?:[\w{{DASH}}]*[{{DASH}}]|(?:co[{{DASH}}\s]*)?(?:authored|written|assisted|generated|created|developed|helped|signed[{{DASH}}\s]*off|pair[{{DASH}}\s]*programmed)\s+)(?:by|with)\s*:\s*(?:{{AINAME}}|{{IDNAME}}\s*<[^<>\r\n]+>|[^\r\n]*<?(?:[^<>\s]+@(?:[\w-]+\.)*(?:anthropic\.com|claude\.ai|openai\.com|chatgpt\.com|gemini\.google|cursor\.(?:com|sh)|anysphere\.co|codeium\.com|windsurf\.com|deepseek\.com|mistral\.ai|aider\.chat|x\.ai|cognition\.ai|cognition-labs\.com|cohere\.com|perplexity\.ai|qwen\.ai|moonshot\.ai|antigravity\.google)|(?<![^<\s:])(?:[^<>\s@]*[._+-])?(?:{{MODEL}}|assistant|agent)(?:[._+\d-][^<>\s@]*)?@(?:[\w-]+\.)*(?:google\.com|googlemail\.com|deepmind\.com|microsoft\.com|meta\.com|fb\.com|amazon\.com|nvidia\.com|ibm\.com|apple\.com|alibaba-inc\.com)|(?<![\w.-])(?:agent|{{MODEL}})(?:\[bot\])?@(?:users\.)?noreply\.(?:github\.com|google\.com)|[^<>\s]*{{MODEL}}[^<>\s]*\[bot\]@[^<>\s]+)>?)\s*$

^\s*{{DECOR}}(?:\*{1,2})?(?:generated|written|authored|assisted|powered|created|made|drafted|built|crafted)\s+(?:with|by|using)\s*:?[\s]*(?:the\s+help\s+of\s+)?(?:(?:{{AINAME}}|AI|LLM)|\[(?:{{AINAME}}|AI|LLM)\]\(https?://[^\s)]+\))[.!]?(?:\*{1,2})?\s*$
^\s*(?:>\s*)?\x{1F916}\x{FE0F}?\s*$
