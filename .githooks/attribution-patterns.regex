# Attribution policy (D-52), shared by the commit-msg hook and CI.
# Whole-line identity trailers and attribution footers only.
#
# `define NAME = body` lines declare a named fragment; later lines use it as
# {{NAME}}. Every model, vendor and tool name is listed ONCE, below.
#
# AINAME: after a known name ANY trailing qualifier words or versions are
# accepted (`AI`, `Agent`, `Advanced`, `R1`, `2.0 Flash Thinking`,
# `Workspace`, ...), so a new product tier needs no new rule. It applies to
# footers and to trailers without an e-mail address.
# IDNAME: a trailer that carries a non-vendor e-mail address is how a human
# co-author is credited, and people share first names with models (a person
# called Claude). There the name may be followed only by versions and the
# QUALIFIER words below; vendor addresses are matched by the e-mail rules.
# GENERIC: an assistant named without a model (AI, an LLM, a chatbot, a
# language model) or by its vendor alone (Google AI, Apple Intelligence,
# Meta AI) (ADV23R6-05/06), or a coding, code, programming or review
# assistant, agent or bot (ADV23R7-08). It is used where no e-mail address is given, so a
# human co-author credited with a real address is never matched by it.
# NAME: what an attribution names: an article, then AINAME or GENERIC, with
# an optional possessive (`Claude's help`, ADV23R6-08).
define DASH = \-\x{2010}-\x{2015}\x{2043}\x{2212}\x{2796}\x{02D7}\x{FE58}\x{FE63}\x{FF0D}
define VENDOR = (?:google|alphabet|deepmind|openai|anthropic|meta|facebook|microsoft|github|amazon|aws|mistral|xai|x\.ai|deepseek|alibaba|cognition|cursor|codeium|nvidia|ibm|cohere|perplexity|apple|moonshot|zhipu|sourcegraph|vercel|augment(?:[\s_-]*code)?|replit|stackblitz|all[\s_-]*hands|jetbrains|blackbox|sweep|refact(?:\.ai)?)
define MODEL = (?:claude|chatgpt|gpt|codex|gemini|gemma|bard|copilot|cursor|grok|sonnet|opus|haiku|deepseek|qwen|qwq|llama|mistral|mixtral|codestral|devin|aider|windsurf|codeium|amazon[\s_-]*q|jules|openai|anthropic|antigravity|cline|tabnine|phind|kimi|cody|codewhisperer|(?:chat)?glm|command[\s_-]*r\b|roo[\s_-]*(?:code|cline)|supermaven|continue(?:\.dev)?(?![\p{L}\p{N}])|code[\s_-]*rabbit|v0(?:\.dev)?(?![\p{L}\p{N}]|\.[\p{L}\p{N}])|augment(?:[\s_-]*code|(?![\p{L}\p{N}]))|open[\s_-]*(?:hands|devin)|(?:stackblitz[\s_-]+)?bolt(?:\.new|[\s_-]+(?:ai|agent))(?![\p{L}\p{N}])|stackblitz[\s_-]+bolt(?![\p{L}\p{N}])|replit|jetbrains[\s_-]*(?:ai|junie)(?![\p{L}\p{N}])|junie(?![\p{L}\p{N}])|blackbox[\s_-]*ai(?![\p{L}\p{N}])|sweep[\s_-]*ai(?![\p{L}\p{N}])|code[\s_-]*llama|star[\s_-]*coder|code[\s_-]*geex|ibm[\s_-]*granite|granite[\s_-]*code|code[\s_-]*gemma|code[\s_-]*qwen|refact(?:\.ai)?(?![\p{L}\p{N}])|wizard[\s_-]*coder|yi[\s_-]*coder|o[1-9])
define WORD = [\p{L}\p{N}][\p{L}\p{N}.+'\x{2019}]*
define SEP = [\s_{{DASH}}:/,&()]
define AINAME = (?:(?:{{VENDOR}}(?:[\s_-]*ai)?(?:['\x{2019}]s)?[\s_-]+)*{{MODEL}}[\p{L}\p{N}.+]*(?:['\x{2019}]s)?(?:{{SEP}}+{{WORD}})*{{SEP}}*)
define QUALIFIER = (?:coding|programming|help|assistance|aid|support|input|guidance|model|models|tool|tools|studio|intelligence|llm|ai|code|sonnet|opus|haiku|flash|pro|mini|nano|turbo|large|small|medium|coder|instruct|sol|developer|codex|lite|preview|cli|assist|assistant|editor|agent|agents|chat|workspace|advanced|experimental|exp|thinking|reasoning|reasoner|high|low|max|ultra|plus|online|bot|app|api|web|desktop|extension|ide|enterprise|business|team)
define VERSION = [vr]?\d[\p{L}\p{N}.+]*
define IDNAME = (?:(?:{{VENDOR}}(?:[\s_-]*ai)?(?:['\x{2019}]s)?[\s_-]+)*{{MODEL}}(?:\d[\p{L}\p{N}.+]*)?(?:{{SEP}}+(?:{{QUALIFIER}}|{{VERSION}})\b)*{{SEP}}*)
define GENERIC = (?:(?:{{VENDOR}}(?:['\x{2019}]s)?[\s_-]*(?:ai|intelligence|llms?|assistant|agent|models?)|(?:gen[\s_-]*)?ai|a\.i\.|llms?|chat[\s_-]*bots?|(?:large[\s_-]+)?language[\s_-]+models?|(?:ai[\s_-]*)?(?:coding|code|programming|software|developer|dev|pair[\s_-]*programming|(?:code[\s_-]*)?review)[\s_-]+(?:assistant|agent|bot|copilot|companion)s?)(?![\p{L}\p{N}]))
define GENERICNAME = (?:{{GENERIC}}(?:['\x{2019}]s)?(?:{{SEP}}+(?:{{QUALIFIER}}|{{VERSION}})(?![\p{L}\p{N}]))*{{SEP}}*)
define NAME = (?:(?:an?|the|my|our|some)\s+)?(?:{{AINAME}}|{{GENERICNAME}})
# ATTRIBUTE: an attribution verb or collaboration noun, BY: what joins it to
# the name, HELP: an optional "the help/assistance/input/guidance/suggestions
# ... of/from" phrase (ADV23R5-06/07, ADV23R6-07, ADV23R7-04/05). DECOR also
# accepts a Markdown heading marker (`## Summary by <tool>`, R7-03).
# ADV23R8-07/08: reviewed/fixed verbs, `under` and supervision nouns.
# ADV23R9-08/09: optimised/polished/completed; recommendation, coaching,
# prompt and instruction nouns.
define ATTRIBUTE = (?:generated|produced|written|wrote|authored|assisted|powered|created|made|drafted|built|crafted|developed|coded|implemented|prepared|composed|designed|engineered|edited|refactored|reviewed|fixed|debugged|rewritten|rewrote|pair[{{DASH}}\s]*programm?(?:ed|ing)|co[{{DASH}}\s]*(?:written|authored|developed|created|programm?ed|wrote)|collaborated|collaboration|paired|partnered|teamed(?:[{{DASH}}\s]*up)?|helped|aided|supported|prompted|guided|suggested|summary|summari[sz]ed|optimi[sz]ed|polished|completed|tested|verified|documented|analy[sz]ed|acknowledged|consulted|discussed)
define BY = (?:with|by|via|using|through|from|under|thanks\s+to|courtesy\s+of|alongside|(?:together|jointly)\s+with|in\s+(?:collaboration|partnership|cooperation|conjunction|tandem|consultation|discussion|conversation)\s+with)
define HELP = (?:(?:the\s+|some\s+)?(?:help|assistance|aid|support|input|guidance|suggestions?|contributions?|feedback|ideas?|advice|hints?|review|supervision|oversight|direction|recommendations?|coaching|prompts?|instructions?|consultation|discussions?|conversations?|appreciation|acknowledge?ments?)\s+(?:of|from)\s+)
define DECOR = (?:>\s*)?(?:#{1,6}\s+)?(?:[\p{So}\p{Sk}\x{FE0F}\x{200D}]\s*)*
# TOOLNAME: tools whose bare name is also an ordinary word (a parameter
# sweep, black-box testing, granite), matched only as a trailer value or
# directly after an authorship verb (ADV23R10-04, R11-02, ADV23R11-03/06).
define TOOLNAME = (?:(?:blackbox|sweep|granite)(?:{{SEP}}+(?:{{QUALIFIER}}|{{VERSION}})(?![\p{L}\p{N}]))*{{SEP}}*)
# TOOLCAP: the same tools written as a product name (capitalised), for review,
# test, fix and gratitude phrases where the lower-case word is ordinary prose
# (`Fixed by sweep` stays allowed; R12-02, ADV23R12-08).
define TOOLCAP = (?:(?-i:Blackbox|BlackBox|BLACKBOX|Sweep|SWEEP|Granite|GRANITE)(?:{{SEP}}+(?:{{QUALIFIER}}|{{VERSION}})(?![\p{L}\p{N}]))*{{SEP}}*)

^\s*{{DECOR}}(?:[\w{{DASH}}]*[{{DASH}}]|(?:co[{{DASH}}\s]*)?(?:authored|written|assisted|generated|created|developed|helped|signed[{{DASH}}\s]*off|pair[{{DASH}}\s]*programmed)\s+)(?:by|with|from)\s*:\s*(?:{{NAME}}|{{TOOLNAME}}(?:<[^<>\r\n]+>)?|{{IDNAME}}\s*<[^<>\r\n]+>|[^\r\n]*<?(?:[^<>\s]+@(?:[\w-]+\.)*(?:anthropic\.com|claude\.ai|openai\.com|chatgpt\.com|gemini\.google|cursor\.(?:com|sh)|anysphere\.co|codeium\.com|windsurf\.com|deepseek\.com|mistral\.ai|aider\.chat|x\.ai|cognition\.ai|cognition-labs\.com|cohere\.com|perplexity\.ai|qwen\.ai|moonshot\.ai|antigravity\.google|sourcegraph\.com|zhipuai\.cn|bigmodel\.cn|continue\.dev|supermaven\.com|coderabbit\.ai|v0\.dev|augmentcode\.com|tabnine\.com|phind\.com|all-hands\.dev|replit\.com|stackblitz\.com|bolt\.new|blackbox\.ai|sweep\.dev)|(?<![^<\s:])(?:[^<>\s@]*[._+-])?(?:{{MODEL}}|assistant|agent)(?:[._+\d-][^<>\s@]*)?@(?:[\w-]+\.)*(?:google\.com|googlemail\.com|deepmind\.com|microsoft\.com|meta\.com|fb\.com|amazon\.com|nvidia\.com|ibm\.com|apple\.com|alibaba-inc\.com|vercel\.com|jetbrains\.com)|(?<![\w.-])(?:agent|{{MODEL}})(?:\[bot\])?@(?:users\.)?noreply\.(?:github\.com|google\.com)|[^<>\s]*{{MODEL}}[^<>\s]*\[bot\]@[^<>\s]+)>?)\s*$
# Any other `<Words> by:` / `with:` / `from:` trailer (ADV23R5-10, ADV23R6-09):
# the name may carry only versions and QUALIFIER words, so a human credit (a
# first name that is also a model name, then a surname) stays allowed.
^\s*{{DECOR}}(?:\p{L}+[\s{{DASH}}]+){1,4}(?:by|with|from)\s*:\s*(?:(?:an?|the|my|our|some)\s+)?(?:{{IDNAME}}(?:<[^<>\r\n]+>)?|{{TOOLNAME}}(?:<[^<>\r\n]+>)?|{{GENERICNAME}})\s*$

^\s*{{DECOR}}(?:\*{1,2})?{{ATTRIBUTE}}\s+{{BY}}\s*:?\s*{{HELP}}?(?:{{NAME}}|\[{{NAME}}\]\(https?://[^\s)]+\))[.!]?(?:\*{1,2})?\s*$
# A credit phrase without a verb: `With help from <name>` (ADV23R10-03).
^\s*{{DECOR}}(?:\*{1,2})?{{BY}}\s+{{HELP}}(?:{{NAME}}|\[{{NAME}}\]\(https?://[^\s)]+\))[.!]?(?:\*{1,2})?\s*$
# Gratitude and credit phrases: `Thanks to <name>`, `Courtesy of <name>`,
# `Credited to <name>`, `With credit to <name>` (ADV23R11-04/05); `Thank you
# <name>`, `Kudos to`, `Shoutout to`, `With acknowledgment to`, `In consultation
# with` (ADV23R12-05..07); `Appreciation to`, `In appreciation of`, `In
# discussion with`, `In conversation with` (ADV23R13-06/08).
^\s*{{DECOR}}(?:\*{1,2})?(?:(?:(?:special|many|big|huge)\s+)?thanks\s+(?:go(?:es)?\s+)?to|(?:(?:a\s+)?(?:big|huge|special)\s+)?thank\s+you,?(?:\s+(?:so\s+much\s+)?to)?|kudos\s+to|shout[{{DASH}}\s]*outs?\s+to|courtesy\s+of|(?:with\s+)?(?:co[{{DASH}}\s]*)?credit(?:s|ed)?\s+(?:goes\s+)?to|(?:with\s+)?acknowledge?ments?\s+(?:to|of)|in\s+(?:consultation|discussion|conversation)\s+with|(?:with\s+)?(?:(?:special|much|sincere|great)\s+)?appreciation\s+(?:to|for)|in\s+appreciation\s+of)\s+{{HELP}}?(?:{{NAME}}|{{TOOLCAP}}|\[(?:{{NAME}}|{{TOOLCAP}})\]\(https?://[^\s)]+\))[.!]?(?:\*{1,2})?\s*$
# Credit trailers: `Credit: <name>`, `Credits:`, `Co-credit:` (ADV23R11-05),
# `Acknowledgment:`, `Acknowledgements:` (ADV23R12-06); `Thanks:`,
# `Appreciation:`, `Assistance:`, `AI-Assistance:`, `AI-Generated:` (ADV23R13-07).
# As in other trailers, a human name that starts like a model stays allowed.
^\s*{{DECOR}}(?:(?:co[{{DASH}}\s]*)?credit(?:s|ed)?(?:\s+to)?|acknowledge?ments?|acknowledged|thanks|appreciation|(?:ai[{{DASH}}\s]*)?assist(?:ance|ed)|ai[{{DASH}}\s]*generated)\s*:\s*(?:(?:an?|the|my|our|some)\s+)?(?:{{IDNAME}}(?:<[^<>\r\n]+>)?|{{TOOLNAME}}(?:<[^<>\r\n]+>)?|{{GENERICNAME}})\s*$
# A bare tool name that is also a word, directly after an authorship verb:
# `Generated by <tool>`; `Generated by the parameter sweep` and `Fixed by
# sweep` stay allowed (R11-02, ADV23R11-03/06).
^\s*{{DECOR}}(?:\*{1,2})?(?:generated|written|wrote|authored|produced|created|assisted|coded|implemented|drafted|co[{{DASH}}\s]*(?:written|authored))\s+(?:by|with|using|via)\s*:?\s*(?:{{TOOLNAME}}|\[{{TOOLNAME}}\]\(https?://[^\s)]+\))[.!]?(?:\*{1,2})?\s*$
# Review, test and maintenance verbs with a capitalised bare tool name:
# The verb, a preposition, then the product-name spelling (R12-02, ADV23R12-08).
^\s*{{DECOR}}(?:\*{1,2})?(?:reviewed|fixed|tested|debugged|refactored|edited|verified|validated|checked|maintained|optimi[sz]ed|documented|analy[sz]ed|improved|updated|acknowledged|consulted)\s+(?:by|with|using|via)\s*:?\s*(?:{{TOOLCAP}}|\[{{TOOLCAP}}\]\(https?://[^\s)]+\))[.!]?(?:\*{1,2})?\s*$
# An HTML comment marker (in a PR body) that credits a named tool, such as a
# review bot's auto-generated summary marker (R7-03).
^\s*<!--(?=[^\r\n]*?(?<![\p{L}\p{N}]){{ATTRIBUTE}}(?![\p{L}\p{N}]))(?=[^\r\n]*?(?<![\p{L}\p{N}]){{MODEL}}(?![\p{L}]))[^\r\n]*-->\s*$
^\s*(?:>\s*)?\x{1F916}\x{FE0F}?\s*$
